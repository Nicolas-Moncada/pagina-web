datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Rol {
  GANADERO
  ADMIN
}

enum Turno {
  MANANA
  TARDE
}

model Usuario {
  id           String           @id @default(cuid())
  cedula       String           @unique @db.VarChar(50)
  nombre       String           @db.VarChar(150)
  telefono     String?          @db.VarChar(50)
  passwordHash String           @db.VarChar(255)
  rol          Rol              @default(GANADERO)
  activo       Boolean          @default(true)
  creadoEn     DateTime         @default(now())

  entregas     Entrega[]
  alertas      AlertaQuincena[]

  @@index([cedula])
}

model Entrega {
  id        String   @id @default(cuid())
  usuarioId String
  fecha     String   @db.VarChar(10) // "YYYY-MM-DD" para control exacto sin desfase de zona horaria
  turno     Turno
  litros    Float
  creadoEn  DateTime @default(now())

  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Clave única: un ganadero no puede tener dos entregas en el mismo turno y fecha
  @@unique([usuarioId, fecha, turno])
  @@index([fecha])
  @@index([usuarioId])
}

model Quincena {
  id          String   @id @default(cuid())
  fechaInicio String   @db.VarChar(10) // "YYYY-MM-DD" (ej: "2026-10-01")
  fechaFin    String   @db.VarChar(10) // "YYYY-MM-DD" (ej: "2026-10-15")
  precioLitro Float?   // Nullable: si el admin no lo fijó aún, muestra "precio aún no definido"
  cerrada     Boolean  @default(false)
  creadaEn    DateTime @default(now())

  @@unique([fechaInicio, fechaFin])
}

model Consulta {
  id        String   @id @default(cuid())
  nombre    String   @db.VarChar(150)
  contacto  String   @db.VarChar(150)
  mensaje   String   @db.Text
  fecha     DateTime @default(now())
  atendida  Boolean  @default(false)

  @@index([fecha])
}

model AlertaQuincena {
  id              String   @id @default(cuid())
  usuarioId       String
  fechaInicio     String   @db.VarChar(10)
  fechaFin        String   @db.VarChar(10)
  mensaje         String   @db.Text
  litrosAlMomento Float
  estado          String   @default("PENDIENTE") @db.VarChar(50)
  correoEnviado   Boolean  @default(false)
  creadoEn        DateTime @default(now())

  usuario         Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Restricción única estricta: Solo UNA alerta por ganadero por cada periodo quincenal
  @@unique([usuarioId, fechaInicio, fechaFin])
  @@index([usuarioId])
  @@index([creadoEn])
}
