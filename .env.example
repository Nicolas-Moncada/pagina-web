# Cadena de conexión para XAMPP MySQL
DATABASE_URL="mysql://root:@localhost:3306/asociacion_ganaderos"

# Contraseña inicial para el administrador (Solo en primer arranque, luego se cambia obligatoriamente)
ADMIN_INITIAL_PASSWORD="IngresaAquiTuContrasenaInicialSegura"

# Clave secreta para firmar sesiones y tokens
JWT_SECRET="GeneraUnaClaveSecretaLargaYAleatoria"

# Configuración opcional de CAPTCHA externo (Cloudflare Turnstile o hCaptcha)
CAPTCHA_SITEKEY=""
CAPTCHA_SECRET=""

# Configuración de Correo
SMTP_USER="asoagroalisal@gmail.com"
SMTP_PASS=""

NODE_ENV="production"
