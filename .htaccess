# ================================================================
# SEGURIDAD Y HARDENING APACHE - ASOAGROALIZAL
# 27 Controles de Hardening para Producción y Servidor Local
# ================================================================

# 1. Deshabilitar listado de directorios
Options -Indexes -MultiViews

# 2. Proteger archivos sensibles, credenciales, scripts y documentación privada
<FilesMatch "^(\.env|\.git|\.gitignore|database\.sql|.*\.log|.*\.md|.*\.bat|.*\.sh|.*\.bak|.*\.tmp)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Proteger directorios de lógica interna
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(includes|logs)/ - [F,L]
</IfModule>

# 4. Cabeceras de Seguridad HTTP Globales
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
